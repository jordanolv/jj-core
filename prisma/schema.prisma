// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Utilisateur unique avec deux profils
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Profils Jordan & Juliette
model Profile {
  id        String   @id @default(cuid())
  name      String   @unique // "jordan" ou "juliette"
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  recettes      Recette[]
  abonnements   Abonnement[]
  gardesAnimaux GardeAnimaux[]
}

// Section Cuisine - Recettes
model Recette {
  id           String   @id @default(cuid())
  titre        String
  description  String?
  ingredients  String // JSON array
  etapes       String // JSON array
  tempsPrep    Int? // en minutes
  tempsCuisson Int? // en minutes
  portions     Int?
  categorie    String?
  image        String?
  favorite     Boolean  @default(false)
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([profileId])
}

// Section Argent - Abonnements
model Abonnement {
  id          String   @id @default(cuid())
  nom         String
  prix        Float
  frequence   String // "mensuel", "annuel", "hebdomadaire"
  dateDebut   DateTime
  dateFin     DateTime?
  actif       Boolean  @default(true)
  categorie   String? // "streaming", "sport", "logiciel", etc.
  description String?
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([profileId])
}

// Section Animaux - Gardes
model GardeAnimaux {
  id          String   @id @default(cuid())
  typeAnimal  String // "Chien", "Chat", etc.
  nomAnimal   String
  nomClient   String
  contact     String?
  source      String? // Comment nous ont-ils connus (Instagram, Bouche à oreille, etc.)
  dateDebut   DateTime
  dateFin     DateTime
  duree       String? // "2 jours", "1 semaine", etc.
  tarif       Float
  typeGarde   String // "Garde chez moi", "Visite", etc.
  statut      String   @default("confirmé") // "confirmé", "terminé", "annulé"
  notes       String?
  photos      String[] @default([]) // Array d'URLs des photos
  isShared    Boolean  @default(false) // true = garde commune, false = spécifique au créateur
  profileId   String // Créateur de la garde
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([profileId])
  @@index([dateDebut])
}

// Section Budget - Années
model BudgetYear {
  id        String        @id @default(cuid())
  year      Int           @unique // 2025, 2026, etc.
  profileId String
  months    BudgetMonth[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([year])
  @@index([profileId])
}

// Section Budget - Mois
model BudgetMonth {
  id         String            @id @default(cuid())
  month      Int // 1-12 (Janvier = 1, Décembre = 12)
  yearId     String
  year       BudgetYear        @relation(fields: [yearId], references: [id], onDelete: Cascade)
  incomes    BudgetIncome[]
  expenses   BudgetExpense[]
  categories BudgetCategory[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([yearId, month])
  @@index([yearId])
  @@index([month])
}

// Section Budget - Catégories de dépenses
model BudgetCategory {
  id        String          @id @default(cuid())
  name      String // "Alimentation", "Santé", etc.
  color     String? // Couleur pour l'UI
  icon      String? // Icône pour l'UI
  monthId   String
  month     BudgetMonth     @relation(fields: [monthId], references: [id], onDelete: Cascade)
  expenses  BudgetExpense[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([monthId])
}

// Section Budget - Revenus (Entrées)
model BudgetIncome {
  id          String      @id @default(cuid())
  description String // "Salaire", "CAF", etc.
  amount      Float
  date        DateTime
  monthId     String
  month       BudgetMonth @relation(fields: [monthId], references: [id], onDelete: Cascade)
  profileId   String // Qui a créé cette entrée
  isShared    Boolean     @default(false) // true = revenu commun
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([monthId])
  @@index([profileId])
  @@index([date])
}

// Section Budget - Dépenses
model BudgetExpense {
  id          String         @id @default(cuid())
  description String
  amount      Float
  date        DateTime
  categoryId  String
  category    BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  monthId     String
  month       BudgetMonth    @relation(fields: [monthId], references: [id], onDelete: Cascade)
  profileId   String // Qui a créé cette dépense
  isShared    Boolean        @default(false) // true = dépense commune
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([categoryId])
  @@index([monthId])
  @@index([profileId])
  @@index([date])
}
